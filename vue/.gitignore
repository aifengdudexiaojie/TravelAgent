# ================================================
# 前端 .gitignore (Vue 3 + Vite + TypeScript)
# ================================================

# 依赖
node_modules/
.pnp
.pnp.js

# 构建产物
dist/
dist-ssr/
*.local

# 环境变量（可能包含 API Key，必须排除）
.env
.env.*
!.env.example

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / 编辑器
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 操作系统
.DS_Store
Thumbs.db
