# ============================================================
# LLM 配置
# ============================================================
# ⚠️ 这里只放占位值，千万不要把真实 Key 写进 .env.example（它会被提交到仓库）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FREE_MODEL=deepseek-chat
DEEPSEEK_PROVIDER=openai

KIMI_API_KEY=your_kimi_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
KIMI_PROVIDER=openai

# ============================================================
# 高德地图
# ============================================================
GAODE_API_KEY=your_gaode_key

# ============================================================
# JWT 认证
# ============================================================
JWT_SECRET_KEY=change-this-to-a-random-secret-string

# ============================================================
# Elasticsearch
# ============================================================
ES_URL=http://localhost:9200
ES_USER=
ES_PASSWORD=
# 自签名 HTTPS 证书（ES 开了 xpack.security 时填 http_ca.crt 的路径）
# ES_CA_CERTS=E:\elasticsearch-9.5.3\config\certs\http_ca.crt
# ES_VERIFY_CERTS=true

# ============================================================
# 长短期记忆存储
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_agent
DATABASE_POOL_SIZE=10
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=travel_agent_memories
REDIS_URL=redis://localhost:6379/0
MEMORY_MESSAGE_LIMIT=12
MEMORY_SEARCH_LIMIT=5
MEMORY_SUMMARY_EVERY_MESSAGES=10

# ============================================================
# Embedding 配置（默认：阿里云百炼 qwen3.7-text-embedding-flash，1024 维）
# ============================================================

# 方式1：API（OpenAI 兼容接口）
# 百炼控制台申请 API Key：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=your_dashscope_key
EMBEDDING_API_KEY=your_dashscope_key

# 公共域名（默认，任何账号可用）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 业务空间专属域名（更快更稳）：把 {WorkspaceId} 整体替换为你的空间 ID，注意不要保留大括号
# EMBEDDING_BASE_URL=https://llm-vdjpzdp268ldxbgw.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024
# 可选调优
# EMBEDDING_BATCH_SIZE=10            # 单次请求条数（百炼同步接口有行数上限）
# EMBEDDING_SEND_DIMENSIONS=true     # 是否传 dimensions 参数
# EMBEDDING_TIMEOUT=30

# 方式2：本地模型（取消注释启用）
# USE_LOCAL_EMBEDDING=true
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ============================================================
# 小红书 MCP 并发控制
# ============================================================
XHS_MAX_CONCURRENT=3

# ============================================================
# RAG（检索增强）开关 —— 详见 docs/rag-code-map.md
# ============================================================
# 参与检索的 Qdrant 集合（默认 guide_chunks）
RAG_VECTOR_COLLECTIONS=guide_chunks
# 最终排序权重：final = RAG_W_RRF·归一化RRF + RAG_W_RERANK·归一化rerank
RAG_W_RRF=0.7
RAG_W_RERANK=0.3
# 重排序后端/模型（dashscope / llm / none；qwen3.7-text-rerank 判别力更强）
# RERANK_PROVIDER=dashscope
# RERANK_MODEL=qwen3-rerank
# 生成的攻略是否自动写入知识库；以及结构校验失败时是否抛异常（不写 RAG）
RAG_AUTO_INGEST=true
RAG_VALIDATE_STRICT=true
# 历史模式的检索范围：own（默认，只检索自己的攻略）/ own_or_public / public / all
RAG_CHAT_VISIBILITY=own
# 是否打印各通道召回排序明细
RAG_DEBUG_RANKING=true

# ============================================================
# 后端日志（run_backend.py 会把 stdout/stderr 双写到这个文件，
# 前端「🖥️ 后端日志」页读它；留空则用 <项目根>/logs/backend.log）
# ============================================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8088
# BACKEND_LOG_FILE=D:\TravelAgent\logs\backend.log
# BACKEND_RELOAD=1
# 关闭浏览器端日志接口（生产可设 false）
BACKEND_LOG_ENDPOINT=true
